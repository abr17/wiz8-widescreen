; Export table of our version.dll.
; Left — the name sr.dll and Windows look for; right — our trampoline function
; from proxy_version.cpp, which simply jumps to the real system function.
LIBRARY version
EXPORTS
    GetFileVersionInfoA        = fwd_GetFileVersionInfoA
    GetFileVersionInfoByHandle = fwd_GetFileVersionInfoByHandle
    GetFileVersionInfoExA      = fwd_GetFileVersionInfoExA
    GetFileVersionInfoExW      = fwd_GetFileVersionInfoExW
    GetFileVersionInfoSizeA    = fwd_GetFileVersionInfoSizeA
    GetFileVersionInfoSizeExA  = fwd_GetFileVersionInfoSizeExA
    GetFileVersionInfoSizeExW  = fwd_GetFileVersionInfoSizeExW
    GetFileVersionInfoSizeW    = fwd_GetFileVersionInfoSizeW
    GetFileVersionInfoW        = fwd_GetFileVersionInfoW
    VerFindFileA               = fwd_VerFindFileA
    VerFindFileW               = fwd_VerFindFileW
    VerInstallFileA            = fwd_VerInstallFileA
    VerInstallFileW            = fwd_VerInstallFileW
    VerLanguageNameA           = fwd_VerLanguageNameA
    VerLanguageNameW           = fwd_VerLanguageNameW
    VerQueryValueA             = fwd_VerQueryValueA
    VerQueryValueW             = fwd_VerQueryValueW
; RAD's binkw32.dll 1.0q (the game's video player): its 83 functions, for the copy of this DLL
; that the installer puts in place of binkw32.dll under Wine (src/loader_route.h; the original is
; renamed to binkw32_wiz8wide.dll). Each line is a "forwarder": the export table only says "this
; function is _BinkOpen@8 of binkw32_wiz8wide.dll", and Windows or Wine look the original up when
; a program imports the name. So Wiz8.exe gets the original's own addresses, and the copy loaded
; as version.dll never loads binkw32_wiz8wide.dll (sr.dll imports none of these). The names keep
; RAD's leading "_" and "@N" exactly; the game imports them by name, so the numbers do not matter.
; Every forwarder text must start with "binkw32_wiz8wide.": an older lld (Ubuntu's LLVM 18)
; writes "_binkw32_wiz8wide." there, so build.ps1 checks the built DLL.
    _BinkBufferBlit@12           = binkw32_wiz8wide._BinkBufferBlit@12
    _BinkBufferCheckWinPos@12    = binkw32_wiz8wide._BinkBufferCheckWinPos@12
    _BinkBufferClear@8           = binkw32_wiz8wide._BinkBufferClear@8
    _BinkBufferClose@4           = binkw32_wiz8wide._BinkBufferClose@4
    _BinkBufferGetDescription@4  = binkw32_wiz8wide._BinkBufferGetDescription@4
    _BinkBufferGetError@0        = binkw32_wiz8wide._BinkBufferGetError@0
    _BinkBufferLock@4            = binkw32_wiz8wide._BinkBufferLock@4
    _BinkBufferOpen@16           = binkw32_wiz8wide._BinkBufferOpen@16
    _BinkBufferSetDirectDraw@8   = binkw32_wiz8wide._BinkBufferSetDirectDraw@8
    _BinkBufferSetHWND@8         = binkw32_wiz8wide._BinkBufferSetHWND@8
    _BinkBufferSetOffset@12      = binkw32_wiz8wide._BinkBufferSetOffset@12
    _BinkBufferSetResolution@12  = binkw32_wiz8wide._BinkBufferSetResolution@12
    _BinkBufferSetScale@12       = binkw32_wiz8wide._BinkBufferSetScale@12
    _BinkBufferUnlock@4          = binkw32_wiz8wide._BinkBufferUnlock@4
    _BinkCheckCursor@20          = binkw32_wiz8wide._BinkCheckCursor@20
