# Not in git (kept only locally; where each one comes from - README.md "Repository map" and docs\building.md)

# Portable tools (large, restored by downloading; copies of env.ps1/msvcenv.ps1 - scripts\build\toolchain\)
/Tools/
# Game copies (reference - pristine reference, work - test copy with the patch, ru - test copy with the Russian translation)
/games/
# Third-party decompilation without a license: local only, for reference
/ref/
# Patch files made from the game's art (wide images etc.) and dgVoodoo - not put in git
/assets/
# Released builds (the zip exactly as it went out to players)
/release/
# Build output (everything is restored by scripts)
/build/
# The Ghidra database contains game code, not put in the repository
/ghidra/
# Binaries in the root and any game files
/*.exe
/*.dll
*.CFG
*.SLF

# Python cache
__pycache__/

# Screenshots from test runs (scripts\play\hybrid_session.ps1)
/docs/screens/tour/

# Public screenshots (Reddit posts), not for git
/screenshots/

# Our changes to the third-party decompilation (contains its code, which has no licence): kept locally, not published
/patches/

